# =============================================================================
# MovieLust — copy this file to `.env.local` and fill in your values.
# `.env.local` is gitignored; never commit real keys.
# =============================================================================

# -----------------------------------------------------------------------------
# Required (used by the app)
# -----------------------------------------------------------------------------
# Where to find: Supabase Dashboard → your project → Project Settings → API
#
# Project URL — under "Project URL"
#   Example: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# anon / public key — under "Project API keys" → "anon" / "public"
#   Long JWT starting with eyJ... — safe to expose in the browser with RLS.
#   Do NOT use the "service_role" secret here (that bypasses RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Site URL for documentation / optional future use. Login (Google + email)
# builds return URLs from the browser’s current origin so Production on Vercel
# is not sent to localhost if this is wrong. Still add each origin’s callback
# in Supabase → Authentication → URL configuration → Redirect URLs, e.g.:
#   https://your-deployment.vercel.app/auth/callback
# Example local: http://localhost:4000  (match `npm run dev` port)
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Google sign-in (Supabase Auth) — credentials live in the Supabase Dashboard,
# not in this file. Google Cloud: OAuth 2.0 → Web application client.
# -----------------------------------------------------------------------------
# Supabase → Authentication → Providers → Google:
#   - Enable the provider.
#   - Client Secret (for OAuth): the Web client's client secret from Google.
#   - Authorized Client IDs: required — paste your Web OAuth **Client ID**
#     (xxx.apps.googleusercontent.com). For web-only, that one value is enough.
#     If you add iOS/Android/One Tap clients later, list all IDs comma-separated
#     (web client ID first). See: https://supabase.com/docs/guides/auth/social-login/auth-google
#   - Authorized redirect URI in Google Cloud (fixes Error 400 redirect_uri_mismatch):
#       https://<YOUR_PROJECT_REF>.supabase.co/auth/v1/callback
#     Must be the full URL ending in /auth/v1/callback — the bare host
#     https://…supabase.co is not enough and causes redirect_uri_mismatch.
# Supabase → Authentication → URL configuration:
#   - Redirect URLs: add EVERY origin you use (local + prod are separate lines).
#     Do not remove localhost when you add production — otherwise local sign-in
#     breaks (Supabase falls back to Site URL).
#       http://localhost:4000/auth/callback   ← default `npm run dev` port
#       http://localhost:3000/auth/callback   ← only if you run dev on 3000
#       https://your-deployment.vercel.app/auth/callback

# -----------------------------------------------------------------------------
# Optional (not required for this repo today)
# -----------------------------------------------------------------------------
# Service role — only if you later add server-only admin scripts.
# Never prefix with NEXT_PUBLIC_ — never send to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
